{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable pnpm + Turborepo bilingual PWA monorepo template",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter @app/web --filter @app/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "setup": "node scripts/setup.mjs",
    "db:generate": "pnpm --filter @app/api prisma:generate",
    "db:seed": "pnpm --filter @app/api exec prisma db seed",
    "test": "turbo run test -- --run && node --test test/*.test.mjs",
    "test:ci": "turbo run test:ci && node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "codegen": "pnpm --filter @app/shared build && pnpm --filter @app/api openapi:generate && pnpm --filter @app/web codegen",
    "codegen:check": "bash scripts/check-generated.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.2",
    "turbo": "^2.5.8",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.18.1"
  }
}
